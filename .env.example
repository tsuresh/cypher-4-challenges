# =============================================================================
# CYPHER 4.0 — root configuration
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# All scripts source this file via shared/lib/common.sh.
# =============================================================================

# --- Cloud target -----------------------------------------------------------
CLOUD_TARGET=gcp

# --- GCP project (dedicated sandbox, nothing else lives here) ----------------
GCP_PROJECT_ID=cypher4-ctf-sandbox
GCP_BILLING_ACCOUNT_ID=000000-000000-000000   # required by bootstrap to link billing
GCP_REGION=asia-south1                         # Mumbai; asia-southeast1 (Singapore) is the alt
GCP_ZONE=asia-south1-a

# --- Host model -------------------------------------------------------------
HOST=gce_vm                # Compute Engine VM. GKE is NOT used.
FINALS_ISOLATION=per_team  # ctfd-whale on the finals VM

# --- Public naming ----------------------------------------------------------
BASE_DOMAIN=cypher.example.lk
FLAG_PREFIX=CYPHER

# --- Budget guard -----------------------------------------------------------
BUDGET_CAP_USD=200         # hard budget alert threshold on the sandbox project

# --- Admin access -----------------------------------------------------------
# CIDR ranges allowed to reach SSH (port 22). Comma-separated. Never 0.0.0.0/0.
ADMIN_SOURCE_RANGES=203.0.113.10/32
# Email that receives budget + infra alerts.
ALERT_EMAIL=sctf-admin@example.lk

# --- VM sizing (overridable) ------------------------------------------------
PHASE1_MACHINE_TYPE=e2-standard-4
PHASE1_BOOT_DISK_GB=50
PHASE1_BOOT_DISK_TYPE=pd-balanced
PHASE1_USE_SPOT=true       # Spot acceptable for phase 1 build/testing

PHASE2_MACHINE_TYPE=e2-standard-8   # scale to e2-standard-16 if load test shows pressure
PHASE2_BOOT_DISK_GB=100
PHASE2_BOOT_DISK_TYPE=pd-ssd
PHASE2_USE_SPOT=false      # finals VM is NEVER Spot

# --- CTFd admin bootstrap ---------------------------------------------------
CTFD_ADMIN_USER=admin
CTFD_ADMIN_EMAIL=sctf-admin@example.lk
# Leave blank to have provision.sh generate a strong password and print it once.
CTFD_ADMIN_PASSWORD=
# CTFd session secret — REQUIRED because CTFd runs multiple workers. Leave blank
# and provision.sh generates + persists one (.state/ctfd_secret_key). For a
# manual `docker compose up`, set it: openssl rand -hex 32
CTFD_SECRET_KEY=

# --- CTFd database credentials ----------------------------------------------
# PRODUCTION: set these to strong values. They default to 'ctfd'/'root' for
# local dev only — never ship the defaults to a public instance.
CTFD_DB_PASSWORD=
CTFD_DB_ROOT_PASSWORD=

# --- whale / frp (finals per-team instances) --------------------------------
FRP_PORT_RANGE_START=10000
FRP_PORT_RANGE_END=10100
# Routing mode for per-team instances: "port" (simple) or "subdomain" (needs *.BASE_DOMAIN)
WHALE_ROUTE_MODE=port
